{
  "name": "@noli42/chosen",
  "version": "3.1.3",
  "description": "Chosen is a library for making long, unwieldy select boxes more friendly.",
  "main": "chosen.min.js",
  "scripts": {
    "build:css": "sass src/chosen.scss dist/chosen.css",
    "minify:css": "postcss dist/chosen.css --use cssnano -o dist/chosen.min.css",
    "build:js": "terser src/chosen.js -o dist/chosen.min.js --compress --mangle",
    "copy:js": "cp src/chosen.js dist/chosen.js",
    "build": "npm run build:css && npm run minify:css && npm run build:js && npm run copy:js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "test:all": "npm run test && npm run test:browser"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/noli42/chosen.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "cssnano": "^7.0.6",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.47",
    "postcss-cli": "^11.0.0",
    "sass": "^1.79.1",
    "terser": "^5.33.0",
    "vitest": "^4.1.5"
  },
  "files": [
    "chosen.js",
    "chosen.min.js",
    "chosen.css",
    "chosen.min.css",
    "chosen.css.map"
  ]
}
